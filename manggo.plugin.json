{
  "manifestVersion": 1,
  "id": "com.TechDecryptor.manggo.free-pack",
  "name": "Manggo 免费翻译服务包",
  "version": "1.0.1",
  "description": "为 Manggo 提供无需账号、API Key 或额外配置的翻译服务。",
  "author": "TechDecryptor",
  "homepage": "https://github.com/TechDecryptor/manggo-plugin-free-pack",
  "icon": "icon.jpeg",
  "permissions": [
    "network"
  ],
  "runtime": {
    "kind": "bun",
    "api": "manggo.plugin.v1",
    "main": "main.js"
  },
  "services": [
    {
      "id": "transmart",
      "providerId": "com.TechDecryptor.manggo.free-pack.transmart",
      "kind": "translation",
      "displayName": "腾讯交互翻译",
      "entry": "translateTransmart",
      "resultType": "text",
      "icon": "transmart.svg",
      "language": {
        "auto": "auto",
        "en_US": "en",
        "zh_CN": "zh",
        "zh_TW": "zh-TW",
        "ja_JP": "ja",
        "ko_KR": "ko",
        "fr_FR": "fr",
        "vi_VN": "vi",
        "de_DE": "de",
        "it_IT": "it",
        "ru_RU": "ru"
      },
      "config": []
    },
    {
      "id": "volcengine",
      "providerId": "com.TechDecryptor.manggo.free-pack.volcengine",
      "kind": "translation",
      "displayName": "火山翻译",
      "entry": "translateVolcengine",
      "resultType": "text",
      "icon": "volcengine.svg",
      "language": {
        "auto": "detect",
        "en_US": "en",
        "zh_CN": "zh",
        "zh_TW": "zh",
        "ja_JP": "ja",
        "ko_KR": "ko",
        "fr_FR": "fr",
