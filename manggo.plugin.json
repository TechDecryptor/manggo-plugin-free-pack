      "kind": "translation",
      "displayName": "有道翻译",
      "entry": "translateYoudao",
      "resultType": "dictionary",
      "icon": "youdao.svg",
      "language": {
        "auto": "auto",
        "en_US": "en",
        "zh_CN": "zh-CHS",
        "zh_TW": "zh-CHT",
        "ja_JP": "ja",
        "ko_KR": "ko",
